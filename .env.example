# Host port for local MCP clients. Do not publish this port to the Internet.
DOCSET_PORT=8765
# Limits per docset archive (units: GiB); huge docsets may need higher values.
DOCSET_MAX_ARCHIVE_GB=4
DOCSET_MAX_EXPANDED_GB=12
DOCSET_MAX_FILES=250000

# Optional: override trusted Host values for HTTP MCP. Keep this local-only.
# DOCSET_MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*,mcp,mcp:*
