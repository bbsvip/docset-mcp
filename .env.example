# The Compose HTTP port is fixed at 8777 (published as 0.0.0.0:8777:8765).
# It is intended for trusted local networks only. Do not port-forward it.
# If the server LAN address differs from 192.168.1.11, replace the address
# in the Host allowlist below. This is the SERVER address, not the client IP.
DOCSET_MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*,mcp,mcp:*,192.168.1.11,192.168.1.11:*
# Limits per docset archive (units: GiB); huge docsets may need higher values.
DOCSET_MAX_ARCHIVE_GB=4
DOCSET_MAX_EXPANDED_GB=12
DOCSET_MAX_FILES=250000

# Automatic documentation maintenance (enabled in Compose by default).
# missing: install a docset when an agent explicitly requests its name/ID.
# off: never download from search/read calls. Global searches never auto-download.
DOCSET_AUTO_INSTALL=missing
DOCSET_AUTO_INDEX_CONTENT=true
DOCSET_REFRESH_CATALOG_PERIODICALLY=true
# How old the cached catalog may be before a refresh attempt (hours).
DOCSET_CATALOG_REFRESH_HOURS=24
# Upper bound of HTML pages indexed in a docset (maximum supported: 100000).
DOCSET_FTS_MAX_PAGES=100000
# Background one-time backfill for existing docsets when MCP starts.
DOCSET_FTS_BACKFILL_ON_START=true
